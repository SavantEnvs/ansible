# Mayhem target: fuzz_distribution (Atheris/libFuzzer harness mayhem/harnesses/fuzz_distribution.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_distribution

cmds:
  - cmd: /mayhem/fuzz_distribution
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_distribution/testsuite
