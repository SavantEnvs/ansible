# Mayhem target: fuzz_vault (Atheris/libFuzzer harness mayhem/harnesses/fuzz_vault.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_vault

cmds:
  - cmd: /mayhem/fuzz_vault
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_vault/testsuite
