# Mayhem target: fuzz_task (Atheris/libFuzzer harness mayhem/harnesses/fuzz_task.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_task

cmds:
  - cmd: /mayhem/fuzz_task
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_task/testsuite
