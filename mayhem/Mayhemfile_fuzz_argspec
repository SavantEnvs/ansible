# Mayhem target: fuzz_argspec (Atheris/libFuzzer harness mayhem/harnesses/fuzz_argspec.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_argspec

cmds:
  - cmd: /mayhem/fuzz_argspec
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_argspec/testsuite
