# Mayhem target: fuzz_parse (Atheris/libFuzzer harness mayhem/harnesses/fuzz_parse.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_parse

cmds:
  - cmd: /mayhem/fuzz_parse
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_parse/testsuite
