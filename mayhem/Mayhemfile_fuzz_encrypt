# Mayhem target: fuzz_encrypt (Atheris/libFuzzer harness mayhem/harnesses/fuzz_encrypt.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_encrypt

cmds:
  - cmd: /mayhem/fuzz_encrypt
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_encrypt/testsuite
