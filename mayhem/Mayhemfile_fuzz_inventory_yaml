# Mayhem target: fuzz_inventory_yaml (Atheris/libFuzzer harness mayhem/harnesses/fuzz_inventory_yaml.py, run via the ELF launcher).
project: savantenvs/ansible
target: fuzz_inventory_yaml

cmds:
  - cmd: /mayhem/fuzz_inventory_yaml
    libfuzzer: true
    timeout: 20

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_inventory_yaml/testsuite
